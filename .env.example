OKX_API_KEY=your_api_key_here
OKX_SECRET=your_secret_here
OKX_PASSPHRASE=your_passphrase_here
OKX_MODE=demo
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/trading
MAX_DAILY_LOSS_USD=100
MAX_MONTHLY_LOSS_USD=500
RISK_STARTING_EQUITY_USD=10000
MAX_TOTAL_DRAWDOWN_PCT=10
RISK_FAIL_CLOSED=true
MAX_POSITION_SIZE_PCT=10
MAX_TOTAL_EXPOSURE_PCT=100
MAX_PAIR_EXPOSURE_PCT=100

# Optional volatility-based size scaling
RISK_VOL_ENABLED=false
RISK_VOL_LOOKBACK=60
RISK_VOL_TARGET_PCT=1.5
RISK_VOL_MIN_SCALE=0.25
RISK_VOL_MAX_SCALE=1.0

# Optional execution hardening
ORDER_SPLIT_ENABLED=false
ORDER_SPLIT_PARTS=1
ORDER_SPLIT_INTERVAL_SEC=0.4
ORDER_RETRY_MAX_ATTEMPTS=3
ORDER_RETRY_BACKOFF_SEC=0.6
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_POLL_TIMEOUT_SEC=25

# Chronos-2 hybrid strategy (optional)
CHRONOS_ENABLED=false
CHRONOS_MODEL_ID=amazon/chronos-2
CHRONOS_DEVICE_MAP=cpu
CHRONOS_TIMEOUT_SEC=12
CHRONOS_PREDICTION_LENGTH=8
CHRONOS_MIN_CONTEXT=256
CHRONOS_ENTRY_EDGE_PCT=0.14
CHRONOS_EXIT_EDGE_PCT=0.03
CHRONOS_MAX_UNCERTAINTY_PCT=1.4
CHRONOS_BASE_SIZE_PCT=100
CHRONOS_MIN_SIZE_PCT=35
CHRONOS_REGIME_CONFIDENCE_MIN=0.78

# Optional per-pair tail-risk overlay params (put inside strategy `parameters_json`)
# {
#   "tail_risk_overlay_enabled": true,
#   "risk_hard_stop_pct": 2.0,
#   "risk_trailing_activation_pct": 1.5,
#   "risk_trailing_stop_pct": 0.8,
#   "time_stop_candles": 8,
#   "time_stop_edge_pct": 0.03,
#   "degrade_after_losses": 2,
#   "pause_after_losses": 3,
#   "degrade_size_scale": 0.5,
#   "pause_minutes": 120
# }
